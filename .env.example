# 复制成 .env 后使用：cp .env.example .env
# ===== 必填 =====
# Telegram Bot Token（@BotFather 创建），留空则只启动网页面板
TELEGRAM_BOT_TOKEN=

# ===== 选填 =====
# 监听地址与端口
# PORT 同时用于 docker compose 的宿主机端口映射（改这里即可，如 PORT=9000）
HOST=0.0.0.0
PORT=8080

# 数据目录（SQLite、日志）
DATA_DIR=./data
# 也可以直接指定数据库地址，优先级高于 DATA_DIR
# DATABASE_URL=sqlite+aiosqlite:////data/pansaver.db

# 后台登录会话有效期（小时）
SESSION_TTL_HOURS=168
# 通过 HTTPS 访问时设为 true（Cookie 会带 Secure 标记）
COOKIE_SECURE=false

# 是否允许「首个访问者」直接初始化管理员。多人可访问的环境建议设为 false，
# 并配合 SETUP_TOKEN 使用。
ALLOW_OPEN_SETUP=true
SETUP_TOKEN=

# Bot 是否启用（临时停 Bot 但保留面板时设 false）
BOT_ENABLED=true
# Bot 走代理（例如 http://127.0.0.1:7890）
BOT_PROXY=
# 单条消息最多处理几个链接
BOT_MAX_LINKS_PER_MESSAGE=3

# 开启 Mock 网盘（仅本地调试/自动化测试用，不要在生产开启）
ENABLE_MOCK=false

# HTTP 请求超时（秒）
HTTP_TIMEOUT=20
